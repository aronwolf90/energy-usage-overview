<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.energy-usage-overview"
          path="/org/gnome/shell/extensions/energy-usage-overview/">
    <key name="show-power-label" type="b">
      <default>true</default>
      <summary>Show the current power draw next to the panel icon</summary>
    </key>
    <key name="entries" type="i">
      <range min="3" max="25"/>
      <default>10</default>
      <summary>Number of programs listed in the menu</summary>
    </key>
    <key name="default-period" type="s">
      <choices>
        <choice value="now"/>
        <choice value="hour"/>
        <choice value="day"/>
        <choice value="week"/>
        <choice value="month"/>
      </choices>
      <default>'now'</default>
      <summary>Period selected when the menu opens</summary>
    </key>
  </schema>
</schemalist>
